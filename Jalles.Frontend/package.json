{
  "name": "jalles",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc && npm run build-sass",
    "build:watch": "concurrently \"tsc --watch\" \"npm run build-sass -- --watch\"",
    "build-sass": "sass src/styles/main.scss ../Jalles.Web/wwwroot/build/style.css",
    "lint": "npm run lint:ts && npm run lint:styles",
    "lint:ts": "eslint src/**/*.ts",
    "lint:styles": "stylelint src/**/*.scss"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "@typescript-eslint/parser": "^5.61.0",
    "concurrently": "^7.5.0",
    "eslint": "^8.44.0",
    "postcss-scss": "^4.0.6",
    "sass": "^1.55.0",
    "stylelint": "^14.13.0",
    "tslib": "^2.6.0",
    "typescript": "^4.8.4"
  }
}
