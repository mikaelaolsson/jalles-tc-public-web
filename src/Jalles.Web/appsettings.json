{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "663b55c7-a699-49c6-999b-31f7eb8dc3a9",
        "UseHttps": true,
        "SanitizeTinyMce": true
      },
      "Content": {
        "LoginBackgroundImage": "../static/images/jalles-media.jpg",
        "LoginLogoImage": "../static/images/jalles-logo-yellow.svg",
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        },
        "Error404Collection": [
          {
            "Culture": "default",
            "ContentKey": "83f3dd74-d9e1-492d-9e9a-f48cf40a26c0"
          }
        ]
      },
      "Hosting": {
        "LocalTempStorageLocation": "EnvironmentTemp"
      },
      "Examine": {
        "LuceneDirectoryFactory": "SyncedTempFileSystemDirectoryFactory"
      }
    }
  },
  "uSync": {
    "Settings": {
      "ExportOnSave": "Settings",
      "UIEnabledGroups": "Settings"
    }
  }
}
