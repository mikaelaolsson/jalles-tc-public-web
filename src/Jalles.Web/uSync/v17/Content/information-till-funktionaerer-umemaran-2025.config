            "markup": "\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 35.1pt; mso-outline-level: 2; background: #FAFAEC;\u0022 class=\u0022MsoNormal\u0022\u003E\u003Cspan style=\u0022font-size: 18.0pt; font-family: \u0027Trebuchet MS\u0027,sans-serif; mso-fareast-font-family: \u0027Times New Roman\u0027; mso-bidi-font-family: \u0027Times New Roman\u0027; color: #1e2022;\u0022 lang=\u0022EN-US\u0022\u003EInformation till funktion\u00E4rer Umemaran\u003C/span\u003E\u003C/p\u003E\n\u003Ctable border=\u00220\u0022 cellspacing=\u00220\u0022 cellpadding=\u00220\u0022 class=\u0022MsoNormalTable\u0022 style=\u0022border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Ctbody\u003E\n\u003Ctr style=\u0022mso-yfti-irow: 0; mso-yfti-firstrow: yes;\u0022\u003E\n\u003Ctd width=\u0022133\u0022 valign=\u0022top\u0022 style=\u0022width: 99.55pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003EN\u00E4r\u003C/p\u003E\n\u003C/td\u003E\n\u003Ctd width=\u0022510\u0022 valign=\u0022top\u0022 style=\u0022width: 382.35pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027,serif; mso-fareast-font-family: \u0027Times New Roman\u0027;\u0022 lang=\u0022EN-US\u0022\u003EL\u00F6rdagen den 11:e oktober 2025\u003C/span\u003E\u003C/p\u003E\n\u003C/td\u003E\n\u003C/tr\u003E\n\u003Ctr style=\u0022mso-yfti-irow: 1;\u0022\u003E\n\u003Ctd width=\u0022133\u0022 valign=\u0022top\u0022 style=\u0022width: 99.55pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003EVar\u003C/p\u003E\n\u003C/td\u003E\n\u003Ctd width=\u0022510\u0022 valign=\u0022top\u0022 style=\u0022width: 382.35pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027,serif; mso-fareast-font-family: \u0027Times New Roman\u0027;\u0022 lang=\u0022EN-US\u0022\u003ETegs centralskola\u003C/span\u003E\u003C/p\u003E\n\u003C/td\u003E\n\u003C/tr\u003E\n\u003Ctr style=\u0022mso-yfti-irow: 2;\u0022\u003E\n\u003Ctd width=\u0022133\u0022 valign=\u0022top\u0022 style=\u0022width: 99.55pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003EAvprickning\u003C/p\u003E\n\u003C/td\u003E\n\u003Ctd width=\u0022510\u0022 valign=\u0022top\u0022 style=\u0022width: 382.35pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027,serif; mso-fareast-font-family: \u0027Times New Roman\u0027; mso-ansi-language: SV;\u0022\u003EFunktion\u00E4rer anm\u00E4ler sig p\u00E5 Tegs centralskola senast 09:30\u003C/span\u003E\u003C/p\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; margin-left: 36.0pt; text-indent: -18.0pt; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u00B7\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0Funktion\u00E4rsv\u00E4st\u003C/p\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; margin-left: 36.0pt; text-indent: -18.0pt; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u00B7\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0Flagga\u003C/p\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; margin-left: 36.0pt; text-indent: -18.0pt; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u00B7\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0Ev skylt med \u201DT\u00E4vling p\u00E5g\u00E5r\u201D\u003C/p\u003E\n\u003C/td\u003E\n\u003C/tr\u003E\n\u003Ctr style=\u0022mso-yfti-irow: 3;\u0022\u003E\n\u003Ctd width=\u0022133\u0022 valign=\u0022top\u0022 style=\u0022width: 99.55pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003EStarttider\u003C/p\u003E\n\u003C/td\u003E\n\u003Ctd width=\u0022510\u0022 valign=\u0022top\u0022 style=\u0022width: 382.35pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; margin-left: 36.0pt; text-indent: -18.0pt; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u00B7\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u201DSlowrunners\u201D 10:00\u003C/p\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; margin-left: 36.0pt; text-indent: -18.0pt; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u00B7\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0Umemaran 11:00\u003C/p\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; margin-left: 36.0pt; text-indent: -18.0pt; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u00B7\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0Halvmaran 11:30\u003C/p\u003E\n\u003C/td\u003E\n\u003C/tr\u003E\n\u003Ctr style=\u0022mso-yfti-irow: 4;\u0022\u003E\n\u003Ctd width=\u0022133\u0022 valign=\u0022top\u0022 style=\u0022width: 99.55pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027,serif; mso-fareast-font-family: \u0027Times New Roman\u0027;\u0022 lang=\u0022EN-US\u0022\u003EN\u00E4r \u00E4r det klart?\u003C/span\u003E\u003C/p\u003E\n\u003C/td\u003E\n\u003Ctd width=\u0022510\u0022 valign=\u0022top\u0022 style=\u0022width: 382.35pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027,serif; mso-fareast-font-family: \u0027Times New Roman\u0027; mso-ansi-language: SV;\u0022\u003EK\u00F6cyklist kommer att starta runt 14:30 och l\u00E4gger l\u00F6pande upp info p\u00E5 Jalles facebook (finns som kommentar p\u00E5 ett inl\u00E4gg om Umemaran). \u003C/span\u003ERunt 16:00 brukar det vara klart.\u003C/p\u003E\n\u003C/td\u003E\n\u003C/tr\u003E\n\u003Ctr style=\u0022mso-yfti-irow: 5;\u0022\u003E\n\u003Ctd width=\u0022133\u0022 valign=\u0022top\u0022 style=\u0022width: 99.55pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003EObs!\u003C/p\u003E\n\u003C/td\u003E\n\u003Ctd width=\u0022510\u0022 valign=\u0022top\u0022 style=\u0022width: 382.35pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027,serif; mso-fareast-font-family: \u0027Times New Roman\u0027; mso-ansi-language: SV;\u0022\u003ET\u00E4nk p\u00E5 att funktion\u00E4rer m\u00E5ste finnas p\u00E5 plats hela tiden tills sista t\u00E4vlande passerat. \u00C4ven om det blir glest mellan dem s\u00E5 kan deras behov av v\u00E4gledning vara nog st\u00E5 stort.\u003C/span\u003E\u003C/p\u003E\n\u003C/td\u003E\n\u003C/tr\u003E\n\u003Ctr style=\u0022mso-yfti-irow: 6; mso-yfti-lastrow: yes;\u0022\u003E\n\u003Ctd width=\u0022133\u0022 valign=\u0022top\u0022 style=\u0022width: 99.55pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027,serif; mso-fareast-font-family: \u0027Times New Roman\u0027;\u0022 lang=\u0022EN-US\u0022\u003EVad ska g\u00F6ras?\u003C/span\u003E\u003C/p\u003E\n\u003C/td\u003E\n\u003Ctd width=\u0022510\u0022 valign=\u0022top\u0022 style=\u0022width: 382.35pt; padding: 0cm 0cm 0cm 0cm;\u0022\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027,serif; mso-fareast-font-family: \u0027Times New Roman\u0027; mso-ansi-language: SV;\u0022\u003ENi ska se till att l\u00F6parna f\u00E5r ett s\u00E5 problemfritt lopp som m\u00F6jligt. Ni har inga formella befogenheter:\u003C/span\u003E\u003C/p\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; margin-left: 36.0pt; text-indent: -18.0pt; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u00B7\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027,serif; mso-fareast-font-family: \u0027Times New Roman\u0027; mso-ansi-language: SV;\u0022\u003EUppm\u00E4rksamma trafikanter att l\u00F6pare \u00E4r p\u00E5 g\u00E5ng\u003C/span\u003E\u003C/p\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; margin-left: 36.0pt; text-indent: -18.0pt; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u00B7\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0Se till att l\u00F6pare springer r\u00E4tt v\u00E4g\u003C/p\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; margin-left: 36.0pt; text-indent: -18.0pt; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u00B7\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027,serif; mso-fareast-font-family: \u0027Times New Roman\u0027; mso-ansi-language: SV;\u0022\u003EF\u00F6rs\u00F6k att f\u00F6rutse incidenter s\u00E5 att de kan undvikas\u003C/span\u003E\u003C/p\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; margin-left: 54.0pt; mso-add-space: auto; text-indent: -18.0pt; line-height: 22.95pt; mso-list: l0 level1 lfo1;\u0022 class=\u0022MsoListParagraph\u0022\u003E\u003C!-- [if !supportLists]--\u003E\u003Cspan style=\u0022font-size: 12.0pt; font-family: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol; mso-ansi-language: SV;\u0022\u003E\u003Cspan style=\u0022mso-list: Ignore;\u0022\u003E\u00B7\u003Cspan style=\u0022font: 7.0pt \u0027Times New Roman\u0027;\u0022\u003E\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0 \u003C/span\u003E\u003C/span\u003E\u003C/span\u003E\u003C!--[endif]--\u003EOm l\u00F6pare bryter, m\u00E5ste de ta sig till m\u00E5l och kontakta speakerb\u00E5set\u003C/p\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; margin-left: 36.0pt; text-indent: -18.0pt; line-height: 22.95pt;\u0022 class=\u0022MsoNormal\u0022\u003E\u00B7\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027,serif; mso-fareast-font-family: \u0027Times New Roman\u0027; mso-ansi-language: SV;\u0022\u003EVid olycka som kr\u00E4ver v\u00E5rd ska ni ringa 112\u003C/span\u003E\u003C/p\u003E\n\u003C/td\u003E\n\u003C/tr\u003E\n\u003C/tbody\u003E\n\u003C/table\u003E\n\u003Cp style=\u0022mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: 23.4pt; mso-outline-level: 3; background: #FAFAEC;\u0022 class=\u0022MsoNormal\u0022\u003E\u00A0\u003C/p\u003E"
          }
        }
      ]
    },
