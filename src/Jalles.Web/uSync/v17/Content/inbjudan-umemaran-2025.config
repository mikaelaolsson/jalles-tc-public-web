    <blocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "9d79fbb7-8d4f-42ad-8acf-385060f8a877",
      "key": "8773233d-cadc-4f9d-a374-b1e977db075e",
      "udi": null,
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Jalles TC Ume\u00E5 \u0026 IFK Ume\u00E5 inbjuder till 52:a Umemaran"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp align=\u0022center\u0022\u003E\u0026nbsp;\u003C/p\u003E\n\u003Cp align=\u0022center\u0022\u003E\u003Cimg src=\u0022?rmode=max\u0026amp;width=500\u0026amp;height=334\u0022 alt=\u0022\u0022 width=\u0022500\u0022 height=\u0022334\u0022 data-udi=\u0022umb://media/916089882fea4c64b2f971a91bfb0c07\u0022\u003E\u003C/p\u003E\n\u003Cp align=\u0022center\u0022\u003E\u003C!--[endif]--\u003EJalles TC Ume\u00E5 \u0026amp; IFK Ume\u00E5 inbjuder till den 52: a Umemaran 11 oktober 2025. T\u00E4vlings- och motionslopp. Marathonloppet \u00E4r samtidigt\u0026nbsp;\u003Cstrong\u003ENorra Norrlandsm\u00E4sterskap\u003C/strong\u003E V\u00E4sterbotten/ Norrbotten f\u00F6r seniorer och veteraner ( 35\u002B), V\u00E4sterbottningens-GP sista delt\u00E4vling. Inga lagt\u00E4vlingar i \u00E5rets t\u00E4vling.\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EStart \u0026amp; M\u00E5l\u003C/strong\u003E:\u0026nbsp;\u0026nbsp;\u0026nbsp; Tegs Centralskola p\u00E5 s\u00F6dra sidan av Ume\u00E4lven\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EStarttider:\u003C/strong\u003E \u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; 42 km kl. 11.00. F\u00F6r slowrunners (4.45 eller l\u00E4ngre) finns m\u00F6jlighet till start kl. 10.00,\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; meddela i f\u00F6rv\u00E4g. 21 km startar kl. 11.30.\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EBanan:\u003C/strong\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; Delvis ny snabbare str\u00E4ckning f\u00F6r \u00E5ret som i stor utstr\u00E4ckning f\u00F6ljer Ume\u00E4lv via \u00D6n p\u00E5 \u00F6mse sidor. Banan kontrollm\u00E4tt av SFIF leg banm\u00E4tare. Varje km \u00E4r skyltad.\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EV\u00E4tska:\u0026nbsp;\u0026nbsp;\u003C/strong\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; Ca var fj\u00E4rde km serveras Umara sportdryck och vatten.\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EOmkl\u00E4dnad:\u0026nbsp;\u003C/strong\u003E\u0026nbsp; Dusch finns p\u00E5 startomr\u00E5det i Jubileumshallen, k\u00E4llarplan f\u00F6r m\u00E4n och kvinnor\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKlasser:\u0026nbsp;\u0026nbsp;\u003C/strong\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; 42 km; Motionsklasser f\u00F6r m\u00E4n ock kvinnor (f\u00F6r ej medlemmar i SFIF). T\u00E4vlingsklasser M\u00E4n \u0026amp; Kvinnor (f\u00F6dd 1991 och senare), M/Kv 35, M/Kv 40, M/Kv 45, M/Kv50, M/Kv55, M/Kv 60, M/Kv65, M/Kv70, M/Kv75, M/Kv 80\u002B (\u00E5lder; kalender\u00E5r g\u00E4ller)\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; 21 km; M\u00E4n och Kvinnor (ing\u00E5r ej i m\u00E4sterskapet)\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EAnm\u00E4lan:\u003C/strong\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; Anm\u00E4lan sker via \u003Ca href=\u0022https://raceid.com/sv/races/\u0022\u003Ehttps://raceid.com/sv/races/\u003C/a\u003E\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; Anm\u00E4lan ska vara registrerad \u003Cstrong\u003Esenast 8 oktober\u003C/strong\u003E och ska inneh\u00E5lla namn,\u003C/p\u003E\n\u003Cp\u003Ef\u00F6delse\u00E5r, f\u00F6rening eller motsvarande, samt klassindelning. Chiptidtagning kommer att till\u00E4mpas. Har du personligt ta med detta, \u00F6vriga l\u00E5nas. Efteranm\u00E4lan kan g\u00F6ras p\u00E5 startplatsen via swish eller kontanter. Chip \u00E5terl\u00E4mnas vid m\u00E5let\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EAvgifter:\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; Halvmarathon 300 kr (efteranm\u00E4lan 400 kr)\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; Helmarathon 500 kr (efteranm\u00E4lan 600 kr)\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; I avgiften ing\u00E5r deltagarmedalj, Umara energibar, kaffe och\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; sm\u00F6rg\u00E5s efter loppet och utlottningsm\u00F6jlighet p\u00E5 42 km\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ENrlapp:\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u003C/strong\u003E\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; H\u00E4mtas p\u00E5 Tegs Centralskola senast 45 minuter f\u00F6re start. Chips uth\u00E4mtas\u003C/p\u003E\n\u003Cp\u003Esamtidigt. F\u00F6r deltagare i VSM ska \u00E4ven en klasslapp s\u00E4ttas p\u00E5 ryggen.\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EV\u00E4rdesaker:\u0026nbsp;\u0026nbsp;\u003C/strong\u003E Inl\u00E4mnas m\u00E4rkta i serveringen p\u00E5 Tegs Centralskola\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EPrisutdelning:\u003C/strong\u003E\u0026nbsp; \u0026nbsp; 21 km direkt efter m\u00E5lg\u00E5ng\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; 42 km ca kl 16.20, Norra Norrlandsm\u00E4sterskap, hederspriser\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; Team Sportia Ersboda lottar ut en cykel bland alla fullf\u00F6ljande p\u00E5 42 km\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; och som personligen \u00E4r n\u00E4rvarande. Prisutdelning Aulan, Tegs Centralskola\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EMedaljer:\u003C/strong\u003E \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; Umemarans medalj f\u00F6r 42 km och 21 km utdelas vid m\u00E5lg\u00E5ng. 42 km diplom f\u00F6r fem\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp;Umemaror, guldmedalj f\u00F6r 10 lopp och\u0026nbsp;utm\u00E4rkelser f\u00F6r \u201Dj\u00E4mna\u201D lopp d\u00E4rut\u00F6ver.\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EB\u00E4sta segertider:\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003Cstrong\u003E42 km\u003C/strong\u003E Kurt Andersson, Skellefte\u00E5 AIK, 2.23.57\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; Sophie Sundberg, V\u00E4sby IK 2.51.09\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003Cstrong\u003E21 km \u003C/strong\u003ETesfeldet Negash, IFK Ume\u00E5 1.07.57\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; Charlotta Andersson, IFK Ume\u00E5 1.17.15\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EF\u00F6r mer info:\u0026nbsp;\u003C/strong\u003E F\u00F6lj fortl\u00F6pande Jalles TC FB eller \u003Ca href=\u0022http://www.jallestc.se\u0022\u003Ewww.jallestc.se\u003C/a\u003E, \u003Ca href=\u0022http://www.ifkumea.com\u0022\u003Ewww.ifkumea.com\u003C/a\u003E\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; 070-6602189 (Leif), 0730-934134 (Hans). T\u00E4vlande sker p\u00E5 egen risk.\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; Anm\u00E4l ev brutet lopp till v\u00E4tskekontroll eller speakervagnen\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C/p\u003E"
          }
        }
      ]
    },
