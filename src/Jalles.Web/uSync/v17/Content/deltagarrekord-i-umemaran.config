  <Properties>
    <blocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "9d79fbb7-8d4f-42ad-8acf-385060f8a877",
      "key": "90fafb27-18d0-4606-9759-8b3cd4bdc443",
      "udi": null,
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Deltagarrekord i Umemaran"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003E\u003Cimg src=\u0022?rmode=max\u0026amp;width=370\u0026amp;height=500\u0022 alt=\u0022\u0022 width=\u0022370\u0022 height=\u0022500\u0022 data-udi=\u0022umb://media/08701cfea63d42098dbf7479419a438f\u0022\u003E\u003C/p\u003E\n\u003Cp\u003EUmemaran, version 51, kommer att sl\u00E5 ett rej\u00E4lt deltagarrekord.\u003C/p\u003E\n\u003Cp\u003EVi har i skrivande stund 127 l\u00F6pare p\u00E5 marathon och 219 p\u00E5 halvmarathon. Det kommer l\u00F6pare fr\u00E5n 17 olika nationaliteter.\u003C/p\u003E\n\u003Cp\u003EDen mest exotiska, en kvinna fr\u00E5n Franska Sydterritoriet, dvs n\u00E4ra Sydpolen och d\u00E4r bor bara 196 inv\u00E5nare!\u003C/p\u003E\n\u003Cp\u003EDet g\u00E5r bra att efteranm\u00E4la sig p\u00E5 l\u00F6rdag f\u00F6re start, men kom i tid.\u003C/p\u003E\n\u003Cp\u003EKassan \u00F6ppnar kl 09. Det \u00E4r stor risk f\u00F6r k\u00F6bildning eller helt enkelt att vi sl\u00E5r i taket vad g\u00E4ller antalet nummerlappar och chip.\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;H\u00E4lsar t\u00E4vlingsledningen\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C/p\u003E"
          }
        }
      ]
    }
  ],
