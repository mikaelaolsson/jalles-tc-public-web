              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EJalles TC Ume\u00E5 \u00C5rsm\u00F6te 29 april klockan 18.30 p\u00E5 Tempelriddarna \u00D6stra Kyrkogatan 14.\u003C/p\u003E\n\u003Cp\u003EPrisutdelningar f\u00F6r KM l\u00F6pning och skidor, samt tr\u00E4ningsflit 200 mil, \u00E5rsm\u00F6tesf\u00F6rhandlingar.\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003EKlubbm\u00E4stare l\u00F6pning 2024 (Umemilen)\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003ERobert Eriksson\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003ERoger Bylund\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003EJens Bylund\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003E\u00A0\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003EKlubbm\u00E4stare skidor 2025 (Umeloppet)\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003E\u003Cimg src=\u0022?rmode=max\u0026amp;width=500\u0022 alt=\u0022Nils J\u0022 width=\u0022500\u0022 height=\u0022368\u0022 data-udi=\u0022umb://media/24a15f6cf9ac4ca8a5fb8786ca5315eb\u0022\u003E\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003E\u00A0\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003EManne Stenstr\u00F6m\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003ENils Johansson\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003EMarie Omgren\u003C/p\u003E\n\u003Cp class=\u0022MsoNormal\u0022\u003E\u00A0\u003C/p\u003E\n\u003Cp\u003EVi bjuder p\u00E5 fika!\u003C/p\u003E"
          }
        }
      ]
    }
