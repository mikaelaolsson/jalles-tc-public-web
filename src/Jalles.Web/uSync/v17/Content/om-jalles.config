        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Om Jalles"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "F\u00F6reningen Jalles Training Camp Ume\u00E5 bildades 1973 av ett litet kamratg\u00E4ng som h\u00F6ll p\u00E5 med terr\u00E4ngl\u00F6pning, landsv\u00E4gsl\u00F6pning och skid\u00E5kning och med m\u00E5ls\u00E4ttningen - Alla ska platsa i g\u00E4nget och idrotta under trivsamma former!"
        },
        {
          "alias": "media",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
