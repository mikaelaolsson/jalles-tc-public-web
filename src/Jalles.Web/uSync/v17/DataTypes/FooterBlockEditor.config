<?xml version="1.0" encoding="utf-8"?>
<DataType Key="af9c4418-5d52-4676-9a80-5ab8ab47c7cd" Alias="Footer Block Editor" Level="2">
  <Info>
    <Name>Footer Block Editor</Name>
    <EditorAlias>Umbraco.BlockList</EditorAlias>
    <EditorUIAlias>Umb.PropertyEditorUi.BlockList</EditorUIAlias>
    <Folder>Custom+Data+Types</Folder>
  </Info>
  <Config><![CDATA[{
  "blocks": [
    {
      "contentElementTypeKey": "031b465a-163c-4ccc-9bea-0e4367593c8c",
      "label": "{{footerText}}",
      "editorSize": "medium",
      "forceHideContentEditorInOverlay": false
    }
  ],
  "useInlineEditingAsDefault": false,
  "useLiveEditing": false,
  "useSingleBlockMode": true,
  "validationLimit": {
    "min": 1,
    "max": 1
  }
}]]></Config>
</DataType>