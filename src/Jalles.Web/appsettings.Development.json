{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Runtime": {
        "Mode": "Development"
      },
      "Content": {
        "MacroErrors": "Throw",
        "Error404Collection": [
          {
            "Culture": "default",
            "ContentKey": "83f3dd74-d9e1-492d-9e9a-f48cf40a26c0"
          }
        ]
      },
      "Hosting": {
        "Debug": true
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://localhost:5001"
      },
      "RuntimeMinification": {
        "UseInMemoryCache": true,
        "CacheBuster": "Timestamp"
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeAuto",
        "ModelsDirectory": "~/../Jalles.Core/Models/Content",
        "ModelsNamespace": "Jalles.Core.Models.Content",
        "AcceptUnsafeModelsDirectory": true,
        "DebugLevel": 1,
        "FlagOutOfDateModels": true
      },
      "Global": {
        "VersionCheckPeriod": 1
      }
    }
  }
}
