@model ImageGalleryBlockViewModel

<div class="image-gallery-modal" id="image-gallery-modal-@Model.Id">
    <div class="close-container">
        <button class="close-button">
            <img src="/images/close.svg" alt="" />
        </button>
    </div>
    <div class="modal-content">
        @{
            var index = 0;
        }
        @foreach (var image in Model.ImageGallery)
        {
            index++;
            <img src="@image.Url()" id="@index" alt="" />
        }
    </div>
</div>