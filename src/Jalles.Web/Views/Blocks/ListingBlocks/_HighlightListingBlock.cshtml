@model HighlightBlockViewModel

@{
    var highlights = Model.Highlights.Count() switch
    {
        1 => "single-highlight",
        2 => "double-highlight",
        _ => ""
    };
}

<div class="highlight-listing-block @Model.BackgroundColor">
    <div class="listing-container @highlights">
        @if(!string.IsNullOrWhiteSpace(Model.Heading))
        {
            <h2>@Model.Heading</h2>
        }

        @foreach(var highlight in Model.Highlights)
        {
            <a href="@highlight.PagePath" class="highlight">
                @if(highlight.Header?.MediaSource is not null)
                {
                    @await Html.PartialAsync("../_MediaBlock.cshtml", highlight.Header)
                }

                <div class="content">
                    <div class="content-container">
                        <h3>@highlight.Title</h3>
                        <span>Läs mer &#10095;</span>
                    </div>
                </div>
            </a>
        }
    </div>
</div>
