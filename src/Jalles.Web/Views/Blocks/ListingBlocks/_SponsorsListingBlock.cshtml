@model SponsorBlockViewModel

<div class="sponsors">
    <h2>@Model.Heading</h2>
    <ul>
        @foreach (var sponsor in Model.Sponsors)
        {
            if (sponsor.Website?.Url is not null)
            {
                <li>
                    <a href="@sponsor.Website.Url" target="_blank">
                        <img src="@(sponsor.LogoSource)?width=256&amp;format=webp" alt="@sponsor.Name" loading="lazy">
                    </a>
                </li>

            }
            else
            {
                <li>
                    <span>
                        <img src="@(sponsor.LogoSource)?width=256&amp;format=webp" alt="@sponsor.Name" loading="lazy">
                    </span>
                </li>

            }
        }
    </ul>
</div>
