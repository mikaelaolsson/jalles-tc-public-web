@model SponsorBlockViewModel 

<div class="sponsors">
    <h2>@Model.Heading</h2>
    <ul>
        @foreach (var sponsor in Model.Sponsors)
        {
            if (sponsor.Website?.Url is not null)
            {
                <li>
                    <a href="@sponsor.Website.Url" target="_blank">
                        <img src="@sponsor.Logo?.MediaUrl()" alt="@sponsor.Name">
                    </a>
                </li>

            }
            else
            {
                <li>
                    <span>
                        <img src="@sponsor.Logo?.MediaUrl()" alt="@sponsor.Name">
                    </span>
                </li>

            }
        }
    </ul>
</div>
