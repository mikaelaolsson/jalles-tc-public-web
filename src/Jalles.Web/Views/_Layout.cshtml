@inherits UmbracoViewPage<LayoutViewModel>
@inject Shorthand.Vite.Contracts.IViteService Vite
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv-SE" xml:lang="sv-SE">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Title</title>
    <meta name="description" content="@Model.MetaDescription">
    <meta property="og:type" content="website">
    <meta property="og:title" content="@Model.Title">
    <meta property="og:description" content="@Model.MetaDescription">
    <meta property="og:image" content="@Model.Thumbnail">
    <meta property="og:url" content="@Model.Url">


    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon">

    <environment exclude="Development">
        <link rel="modulepreload" href="@await Vite.GetAssetUrlAsync("scripts/index.mjs")" as="script" />
        <link rel="stylesheet" href="@await Vite.GetAssetUrlAsync("style.css")" />
    </environment>

</head>

<body>

    @await Html.PartialAsync("../Partials/_Header", Model.Header)

    @RenderBody()

    <vc:footer content="@Model.Content"></vc:footer>


    <script type="module" src="@await Vite.GetAssetUrlAsync("scripts/index.mjs")"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
