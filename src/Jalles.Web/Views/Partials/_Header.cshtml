@model HeaderViewModel

<div class="header">
    @if(Model.MediaBlock?.MediaSource is not null)
    {
        @await Html.PartialAsync("../Blocks/_MediaBlock.cshtml", Model.MediaBlock)
    }

    <div class="content">
        <a href="/" class="startpage-link">
            <img class="logo" src="/static/images/jalles-logo-reverse.svg" alt="Jalles TC - Gå till startsida" title="Jalles TC - Gå till startsida">
        </a>
        @if(!string.IsNullOrWhiteSpace(Model.Heading))
        {
            <h1 class="heading">@Model.Heading</h1>
        }

        @if(!string.IsNullOrWhiteSpace(Model.SubHeading))
        {
            <p class="sub-heading">@Model.SubHeading</p>
        }

        <vc:main-menu></vc:main-menu>
    </div>
</div>
