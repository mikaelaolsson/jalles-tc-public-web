@model MainMenuViewModel

<div class="menu-container">
    <nav class="menu">
        <a href="/" class="startpage-link">
            <img class="logo" src="/static/images/jalles-logo-reverse.svg" alt="Jalles TC - Gå till startsida" title="Jalles TC - Gå till startsida">
            Jalles TC
        </a>
        <button class="open-menu-button" aria-label="Öppna menyn">
            &#9776;
        </button>

        <ul class="menu-items">
            @if (Model.MenuItems.Any())
            {
                foreach (var item in Model.MenuItems)
                {
                    <li>
                        <a href="@item?.PagePath">
                            @item?.Title
                        </a>
                    </li>

                }
            }

            <li>
                <button class="open-search-button" aria-label="Öppna sök">
                    <i class="jalles-icon-search icon-search" aria-hidden="true"></i> <span>Sök</span>
                </button>
            </li>

            @if (!string.IsNullOrWhiteSpace(Model.Facebook))
            {
                <li>
                    <a href="@Model.Facebook" target="_blank" class="facebook"><img src="/static/images/facebook.svg" alt=""> <span>Facebook</span></a>
                </li>
            }
        </ul>
    </nav>
</div>
