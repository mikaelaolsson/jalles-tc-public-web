{
  "$schema": "appsettings-schema.json",
  "Umbraco": {
    "CMS": {
      "Runtime": {
        "Mode": "Production"
      },
      "Hosting": {
        "Debug": false
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://jalles-tc-public-web.azurewebsites.net/"
      },
      "RuntimeMinification": {
        "CacheBuster": "Version"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Content": {
        "MacroErrors": "Silent"
      },
      "Global": {
        "VersionCheckPeriod": 0
      }
    }
  }
}
