@inherits UmbracoViewPage<LayoutViewModel<ListingPageViewModel>>

<main class="listing-page">
    <form id="pagination-form" method="get">
        <input type="hidden" id="page" name="page" value="@Model.ViewModel.Page" />
    </form>


    @if (Model.ViewModel.DisplayTitle)
    {
        <h2>@Model.ViewModel.Title</h2>
    }

    <div class="listings">
        @foreach (var contentPage in Model.ViewModel.ContentPages)
        {
            <a href="@contentPage.GetPageUrl()" class="listing">

                @await Html.PartialAsync("../Blocks/_MediaBlock", contentPage.Header)
                <div class="content">
                    <div class="content-container">
                        <h3>@contentPage.Title</h3>
                        <span>@contentPage.LastEdited.ToString("yyyy-MM-dd")</span>
                    </div>

                </div>
            </a>
        }
    </div>
</main>

@section Scripts
    {
    <script>
        //TODO: find a way to submit this plz
        window.addEventListener("load", (event) => {
            console.log("page is fully loaded");
            const filterForm = document.querySelector('#pagination-form');
            if (filterForm !== null || undefined) {

                filterForm.submit();
            }
        });

    </script>
}
