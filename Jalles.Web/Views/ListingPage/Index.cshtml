@inherits UmbracoViewPage<LayoutViewModel<ListingPageViewModel>>

<main class="listing-page">
    @if (Model.ViewModel.DisplayTitle)
    {
        <h2>@Model.ViewModel.Title</h2>
    }

    <div class="listings">
        @foreach (var contentPage in Model.ViewModel.ContentPages)
        {
            <a href="@contentPage.GetPageUrl()" class="listing">

                @await Html.PartialAsync("../Blocks/_MediaBlock", contentPage.Header)
                <div class="content">
                    <div class="content-container">
                        <h3>@contentPage.Title</h3>
                        <span>Läs mer &#10095;</span>
                    </div>
                </div>
            </a>
        }
    </div>
</main>