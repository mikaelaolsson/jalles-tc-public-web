@model Jalles.Core.Utilities.Pagination

<div class="pagination">

    <button id="previous" @(Model.HasPreviousPage ? "" : "disabled")>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="10.606" viewBox="0 0 18 10.606">
            <title>Previous page</title>
            <path d="M1.822,0,9,7.361,16.237,0,18,1.606l-9,9-9-9Z" fill="#fff"/>
        </svg>
    </button>

    @foreach (var page in Model.DisplayedPages)
    {
        <button class="page-button @(page == Model.Page ? "active" : "")" value="@(page)">@(page)</button>
    }

    <button id="next" @(Model.HasNextPage ? "" : "disabled")>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="10.606" viewBox="0 0 18 10.606">
            <title>Next page</title>
            <path d="M1.822,0,9,7.361,16.237,0,18,1.606l-9,9-9-9Z" fill="#fff"/>
        </svg>
    </button>
</div>
