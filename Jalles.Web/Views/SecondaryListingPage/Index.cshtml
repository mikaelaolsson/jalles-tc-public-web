@inherits UmbracoViewPage<LayoutViewModel<SecondaryListingPageViewModel>>

<main class="listing-page">

    @if (Model.ViewModel.HighlightBlock != null)
    {
        @await Html.PartialAsync("../Blocks/ListingBlocks/_HighlightListingBlock", Model.ViewModel.HighlightBlock)
    }

    @if (Model.ViewModel.PinThisBlock != null)
    {
        @await Html.PartialAsync("../Blocks/_PinThisBlock", Model.ViewModel.PinThisBlock)
    }

    <div class="main-content-container">
        @if (Model.ViewModel.DisplayTitle)
        {
            <h2>@Model.ViewModel.Title</h2>
        }

        @await Html.PartialAsync("../Partials/_ListingPageForm.cshtml", Model.ViewModel)
        <div class="listings">
            @foreach (var contentPage in Model.ViewModel.ContentPages)
            {
                <a href="@contentPage.GetPageUrl()" class="listing">

                    @await Html.PartialAsync("../Blocks/_MediaBlock", contentPage.Header)
                    <div class="content">
                        <div class="content-container">
                            <h3>@contentPage.Title</h3>
                            <span>Läs mer &#10095;</span>
                        </div>
                    </div>
                </a>
            }
            @if (!Model.ViewModel.ContentPages.Any())
            {
                <p>Inga resultat</p>
            }
        </div>
    </div>
</main>

@section Scripts
{
    <script src="~/build/scripts/listing-page-form.js" asp-append-version="true"></script>
}