@using Jalles.Core.Extensions;

@model ContentBlockViewModel

@{
    var mediaAlign = Model.MediaAlign.Equals("Left", StringComparison.OrdinalIgnoreCase) ? "" : "right";
    var backgroundColor = Model.BackgroundColor.GetBackgroundColorName();
}

<div class="content-block @backgroundColor ">
    <div class="content-container @mediaAlign">
        <div class="media-container">
            @await Html.PartialAsync("_MediaBlock.cshtml", Model.Media)

        </div>

        <div class="content">
            @if (!string.IsNullOrWhiteSpace(Model.Heading))
            {
                <h2>@Model.Heading</h2>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Text))
            {
                <p>@Model.Text</p>
            }

            @if (Model.CtaBlocks.Any())
            {
                @await Html.PartialAsync("_CtaBlock.cshtml", Model.CtaBlocks)
            }
        </div>
    </div>

</div>

