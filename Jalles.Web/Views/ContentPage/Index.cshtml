@inherits UmbracoViewPage<LayoutViewModel<ContentPageViewModel>>

@{
    var hasUpdate = @Model.ViewModel.Published.ToString("yyyy-MM-dd") != @Model.ViewModel.LastEdited.ToString("yyyy-MM-dd");
    var hasImageGalleryBlock = Model.ViewModel.Blocks.Any(b => b.Content.ContentType.Alias == "imageGalleryBlock");
}

<main class="content-page">
    @if (!string.IsNullOrWhiteSpace(Model.ViewModel.ParentPagePath))
    {
        <div class="back-button">
            <span class="wrapper"><a href="@Model.ViewModel.ParentPagePath">&#10094; Tillbaka</a></span>
        </div>
    }

    @if (Model.ViewModel.Blocks.Any())
    {
        @await Html.PartialAsync("../Blocks/ListingBlocks/_MixedListingBlock.cshtml", Model.ViewModel.Blocks)
    }

    @if (!string.IsNullOrWhiteSpace(Model.ViewModel.ParentPagePath))
    {
        <ul class="date">
            <li><span>Publicerad: @Model.ViewModel.Published.ToString("yyyy-MM-dd")</span></li>
            @if (hasUpdate)
            {
                <li><span>Uppdaterad: @Model.ViewModel.LastEdited.ToString("yyyy-MM-dd")</span></li>
            }
        </ul>
    }
</main>

@section Scripts
{
    @if (hasImageGalleryBlock)
    {
        <script src="~/build/scripts/image-gallery-modal.js" asp-append-version="true"></script>
    }

    <script src="~/build/scripts/background-color.js" asp-append-version="true"></script>
}