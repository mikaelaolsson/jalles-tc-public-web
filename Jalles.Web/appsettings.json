{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Runtime": {
        "Mode": "Development"
      },
      "Global": {
        "Id": "663b55c7-a699-49c6-999b-31f7eb8dc3a9",
        "UseHttps": true,
        "SanitizeTinyMce": true
      },
      "Content": {
        "LoginBackgroundImage": "../images/jalles-media.jpg",
        "LoginLogoImage": "../images/jalles-logo-yellow.svg",
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://localhost:44334"
      },
      "Hosting": {
        "LocalTempStorageLocation": "EnvironmentTemp"
      },
      "Examine": {
        "LuceneDirectoryFactory": "SyncedTempFileSystemDirectoryFactory"
      }
    }
  }
}