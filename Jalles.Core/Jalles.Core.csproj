    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="Our.Umbraco.Community.Contentment" Version="4.7.0" />
    <PackageReference Include="Our.Umbraco.Community.Contentment.Core" Version="4.7.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.8" />
    <PackageReference Include="Umbraco.Cms.Core" Version="13.10.0" />
    <PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="13.10.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\Content\" />
  </ItemGroup>

	<ItemGroup>
		<Compile Remove="App_Plugins\**" />
	</ItemGroup>
</Project>
